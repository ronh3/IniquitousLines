              },
              {
                "pattern":"^(?<victim>\\S+) rips into (?<victim>\\S+) with massive, deadly claws\\.$",
                "type":"regex"
              },
              {
                "pattern":"^(?<victim>\\S+) quickly pricks (?<victim>\\S+) with \\S+ dirk\\.$",
                "type":"regex"
              },
              {
                "pattern":"^(?<victim>\\S+) follows up the first attack with another, \\S+ dirk piercing the flesh of (?<victim>\\S+)\\.$",
                "type":"regex"
              },
              {
                "pattern":"^(?<victim>\\S+) snaps \\S+ wrist in a practiced motion, bringing .+ back around to strike at (?<victim>\\S+) a second time\\.$",
                "type":"regex" 
              },
              {
                "pattern":"^(?<victim>\\S+) sinks \\w+ fangs into (?<victim>\\S+)'s body\\.$",
                "type":"regex"
              },
              {
                "pattern":"^(?<victim>\\S+) points an imperious finger at (?<victim>\\S+)\\.$",
                "type":"regex"
              },
              {
                "pattern":"^(?<victim>\\S+) stares at (?<victim>\\S+), giving \\S+ the evil eye\\.$",
                "type":"regex"
              }
            ],
